{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tyr:contract:1.1.0:common",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._/-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\)(?!.*:)[a-zA-Z0-9._/-]+$"
    },
    "evidenceRef": {
      "type": "object",
      "properties": {
        "artifactId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._/-]*$"
        },
        "locator": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "text-line"
                },
                "line": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "kind",
                "line"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "xlsx-cell"
                },
                "sheet": {
                  "type": "string",
                  "minLength": 1
                },
                "cell": {
                  "type": "string",
                  "pattern": "^[A-Z]+[1-9][0-9]*$"
                }
              },
              "required": [
                "kind",
                "sheet",
                "cell"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "json-pointer"
                },
                "pointer": {
                  "type": "string",
                  "pattern": "^(|/.*)$"
                }
              },
              "required": [
                "kind",
                "pointer"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "artifactId",
        "locator"
      ],
      "additionalProperties": false
    },
    "documentRef": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._/-]*$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "unit": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "known"
            },
            "code": {
              "enum": [
                "rpm",
                "Cel",
                "N.m",
                "1",
                "1/s",
                "mN.m",
                "K"
              ]
            }
          },
          "required": [
            "status",
            "code"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "not-applicable"
            }
          },
          "required": [
            "status"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "unknown"
            }
          },
          "required": [
            "status"
          ],
          "additionalProperties": false
        }
      ]
    },
    "access": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "device-register"
            },
            "deviceArea": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "addressIndex": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "addressUnit": {
              "anyOf": [
                {
                  "enum": [
                    "word16"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "wordCount": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "bitOffset": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 15
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "kind",
            "deviceArea",
            "addressIndex",
            "addressUnit",
            "wordCount",
            "bitOffset"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "db-offset"
            },
            "dbNumber": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "byteOffset": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "byteLength": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "bitOffset": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 7
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "kind",
            "dbNumber",
            "byteOffset",
            "byteLength",
            "bitOffset"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "symbol"
            },
            "symbolPath": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "kind",
            "symbolPath"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "opcua-node"
            },
            "namespaceUri": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uri"
                },
                {
                  "type": "null"
                }
              ]
            },
            "identifierType": {
              "enum": [
                "string",
                "numeric",
                "guid",
                "opaque"
              ]
            },
            "identifier": {
              "anyOf": [
                {
                  "type": [
                    "string",
                    "integer"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "kind",
            "namespaceUri",
            "identifierType",
            "identifier"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "solution-tag"
            },
            "solutionInstanceRef": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9._/-]*$"
            },
            "tagPath": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "kind",
            "solutionInstanceRef",
            "tagPath"
          ],
          "additionalProperties": false
        }
      ]
    },
    "rawRepresentation": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "bytes"
            },
            "valueType": {
              "anyOf": [
                {
                  "enum": [
                    "Int16",
                    "UInt16",
                    "Int32",
                    "UInt32",
                    "Int64",
                    "Float32",
                    "Float64",
                    "Boolean"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "byteOrder": {
              "anyOf": [
                {
                  "enum": [
                    "little",
                    "big"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "wordOrder": {
              "anyOf": [
                {
                  "enum": [
                    "low-first",
                    "high-first"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "mode",
            "valueType",
            "byteOrder",
            "wordOrder"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "typed"
            },
            "valueType": {
              "anyOf": [
                {
                  "enum": [
                    "Int16",
                    "UInt16",
                    "Int32",
                    "UInt32",
                    "Int64",
                    "Float32",
                    "Float64",
                    "Boolean"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "mode",
            "valueType"
          ],
          "additionalProperties": false
        }
      ]
    },
    "transform": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "linear"
            },
            "factor": {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
            },
            "offset": {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
            }
          },
          "required": [
            "op",
            "factor",
            "offset"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "cast"
            },
            "to": {
              "enum": [
                "Double",
                "Int32",
                "Boolean",
                "String"
              ]
            },
            "overflow": {
              "const": "error"
            },
            "rounding": {
              "enum": [
                "exact",
                "half-even"
              ]
            }
          },
          "required": [
            "op",
            "to",
            "overflow",
            "rounding"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "bit-select"
            },
            "index": {
              "type": "integer",
              "minimum": 0,
              "maximum": 63
            }
          },
          "required": [
            "op",
            "index"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "enum-map"
            },
            "entries": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "raw": {
                    "type": "string",
                    "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
                  },
                  "value": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "raw",
                  "value"
                ],
                "additionalProperties": false
              },
              "minItems": 1
            },
            "onUnknown": {
              "const": "bad-quality"
            }
          },
          "required": [
            "op",
            "entries",
            "onUnknown"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "unit-convert"
            },
            "from": {
              "enum": [
                "1/s",
                "mN.m",
                "K"
              ]
            },
            "to": {
              "enum": [
                "rpm",
                "N.m",
                "Cel"
              ]
            }
          },
          "required": [
            "op",
            "from",
            "to"
          ],
          "additionalProperties": false
        }
      ]
    },
    "resultType": {
      "enum": [
        "Double",
        "Int32",
        "Boolean",
        "String"
      ]
    },
    "fileEntry": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\)(?!.*:)[a-zA-Z0-9._/-]+$"
        },
        "kind": {
          "enum": [
            "evidence-artifact",
            "source-observation",
            "source-definition",
            "semantic-definition",
            "mapping-set",
            "review-record"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._/-]*$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "kind",
        "id",
        "version",
        "sha256"
      ],
      "additionalProperties": false
    }
  }
}
