{
  "type": "object",
  "properties": {
    "kind": {
      "const": "command-binding"
    },
    "schemaVersion": {
      "const": "2.25.0"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "version": {
      "$ref": "common.schema.json#/$defs/version"
    },
    "equipmentRef": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "version": {
          "$ref": "common.schema.json#/$defs/version"
        },
        "equipmentInstanceId": {
          "$ref": "common.schema.json#/$defs/id"
        }
      },
      "required": [
        "id",
        "version",
        "equipmentInstanceId"
      ],
      "additionalProperties": false
    },
    "readBindingRef": {
      "$ref": "common.schema.json#/$defs/documentRef"
    },
    "command": {
      "type": "object",
      "properties": {
        "group": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "edge": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "group",
        "edge"
      ],
      "additionalProperties": false
    },
    "method": {
      "type": "object",
      "properties": {
        "objectNodeId": {
          "type": "string",
          "pattern": "^nsu=[^;]+;s=.+$",
          "maxLength": 2048
        },
        "methodNodeId": {
          "type": "string",
          "pattern": "^nsu=[^;]+;s=.+$",
          "maxLength": 2048
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 256
              },
              "type": {
                "type": "string",
                "maxLength": 64
              },
              "unit": {
                "type": "string",
                "maxLength": 64
              }
            },
            "required": [
              "name",
              "type",
              "unit"
            ],
            "additionalProperties": false
          },
          "maxItems": 32
        }
      },
      "required": [
        "objectNodeId",
        "methodNodeId",
        "inputs"
      ],
      "additionalProperties": false
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/evidenceRef"
      },
      "maxItems": 256
    }
  },
  "required": [
    "kind",
    "schemaVersion",
    "id",
    "version",
    "equipmentRef",
    "readBindingRef",
    "command",
    "method",
    "evidenceRefs"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tyr:contract:2.25.0:command-binding"
}
