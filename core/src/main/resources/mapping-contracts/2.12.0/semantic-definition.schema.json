{
  "type": "object",
  "properties": {
    "kind": {
      "const": "semantic-definition"
    },
    "schemaVersion": {
      "const": "2.12.0"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "version": {
      "$ref": "common.schema.json#/$defs/version"
    },
    "members": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/member"
      },
      "minItems": 1,
      "maxItems": 256
    }
  },
  "required": [
    "kind",
    "schemaVersion",
    "id",
    "version",
    "members"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tyr:contract:2.12.0:semantic-definition",
  "$defs": {
    "member": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "memberId": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9._/-]*$",
              "maxLength": 128
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "semanticId": {
              "type": "string",
              "format": "uri"
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "valueType": {
              "$ref": "common.schema.json#/$defs/resultType"
            },
            "unit": {
              "$ref": "common.schema.json#/$defs/unit"
            },
            "role": {
              "enum": [
                "measurement",
                "status",
                "setpoint"
              ]
            },
            "range": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "low": {
                      "type": "string",
                      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
                    },
                    "high": {
                      "type": "string",
                      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
                    }
                  },
                  "required": [
                    "low",
                    "high"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "memberId",
            "name",
            "semanticId",
            "description",
            "valueType",
            "unit",
            "role",
            "range"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "memberId": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9._/-]*$",
              "maxLength": 128
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "semanticId": {
              "type": "string",
              "format": "uri"
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "valueType": {
              "const": "Structure"
            },
            "members": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/member"
              },
              "minItems": 1,
              "maxItems": 256
            }
          },
          "required": [
            "memberId",
            "name",
            "semanticId",
            "description",
            "valueType",
            "members"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "memberId": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9._/-]*$",
              "maxLength": 128
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "semanticId": {
              "type": "string",
              "format": "uri"
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "valueType": {
              "const": "StructureArray"
            },
            "members": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/member"
              },
              "minItems": 1,
              "maxItems": 256
            },
            "shape": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 256
              },
              "minItems": 1,
              "maxItems": 3
            },
            "lowerBounds": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": -2147483648,
                "maximum": 2147483647
              },
              "minItems": 1,
              "maxItems": 3
            }
          },
          "required": [
            "memberId",
            "name",
            "semanticId",
            "description",
            "valueType",
            "members",
            "shape",
            "lowerBounds"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
