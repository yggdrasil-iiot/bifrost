{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tyr:contract:2.6.0:import-batch",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,47}$"
    },
    "filename": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "format": {
      "enum": [
        "xlsx",
        "tyr-config-json-v1"
      ]
    },
    "bytesBase64": {
      "type": "string",
      "maxLength": 699052
    },
    "equipmentInstanceId": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "capturedAt": {
      "type": "string",
      "format": "date-time"
    },
    "origin": {
      "enum": [
        "field",
        "synthetic"
      ]
    },
    "kind": {
      "const": "import-batch"
    },
    "schemaVersion": {
      "const": "2.6.0"
    },
    "parser": {
      "type": "object",
      "properties": {
        "name": {
          "const": "tyr-bounded-files"
        },
        "version": {
          "const": "1.0.0"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false
    },
    "sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "fileIssue": {
      "type": "string"
    },
    "observations": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^row-[0-9]+$"
          },
          "raw": {},
          "locator": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "text-line"
                  },
                  "line": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "kind",
                  "line"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "xlsx-cell"
                  },
                  "sheet": {
                    "type": "string",
                    "minLength": 1
                  },
                  "cell": {
                    "type": "string",
                    "pattern": "^[A-Z]+[1-9][0-9]*$"
                  }
                },
                "required": [
                  "kind",
                  "sheet",
                  "cell"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "json-pointer"
                  },
                  "pointer": {
                    "type": "string",
                    "pattern": "^(|/.*)$"
                  }
                },
                "required": [
                  "kind",
                  "pointer"
                ],
                "additionalProperties": false
              }
            ]
          },
          "derivation": {
            "type": "array",
            "minItems": 1,
            "maxItems": 65,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "text-line"
                    },
                    "line": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "required": [
                    "kind",
                    "line"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "xlsx-cell"
                    },
                    "sheet": {
                      "type": "string",
                      "minLength": 1
                    },
                    "cell": {
                      "type": "string",
                      "pattern": "^[A-Z]+[1-9][0-9]*$"
                    }
                  },
                  "required": [
                    "kind",
                    "sheet",
                    "cell"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "json-pointer"
                    },
                    "pointer": {
                      "type": "string",
                      "pattern": "^(|/.*)$"
                    }
                  },
                  "required": [
                    "kind",
                    "pointer"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "issues": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "draft": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "$ref": "../2.2.0/source-definition.schema.json"
              }
            ]
          },
          "template": {
            "type": "object"
          },
          "originalColumns": {
            "type": "object"
          },
          "assumptions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "raw",
          "locator",
          "derivation",
          "issues",
          "draft",
          "assumptions"
        ],
        "additionalProperties": false
      }
    },
    "columnMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "enum": [
          "address",
          "base",
          "byteOrder",
          "count",
          "id",
          "identifierType",
          "kind",
          "label",
          "namespaceUri",
          "overrides",
          "profile",
          "stage",
          "stride",
          "target",
          "type",
          "unit",
          "width",
          "wordOrder"
        ]
      }
    },
    "contextConnections": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "equipmentInstanceId": {
            "type": "string"
          },
          "accessProfileRef": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "label",
          "equipmentInstanceId",
          "accessProfileRef"
        ],
        "additionalProperties": false
      }
    },
    "version": {
      "const": "1.0.0"
    }
  },
  "required": [
    "id",
    "filename",
    "format",
    "bytesBase64",
    "equipmentInstanceId",
    "capturedAt",
    "origin",
    "kind",
    "schemaVersion",
    "parser",
    "sha256",
    "observations",
    "columnMap",
    "contextConnections",
    "version"
  ],
  "additionalProperties": false
}
