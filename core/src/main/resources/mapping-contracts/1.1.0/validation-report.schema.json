{
  "type": "object",
  "properties": {
    "kind": {
      "const": "validation-report"
    },
    "schemaVersion": {
      "const": "1.1.0"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "version": {
      "$ref": "common.schema.json#/$defs/version"
    },
    "proposalSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "validator": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false
    },
    "valid": {
      "type": "boolean"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ruleCode": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "error",
              "warning"
            ]
          },
          "documentPath": {
            "anyOf": [
              {
                "$ref": "common.schema.json#/$defs/path"
              },
              {
                "type": "null"
              }
            ]
          },
          "pointer": {
            "type": "string"
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "ruleCode",
          "severity",
          "documentPath",
          "pointer",
          "message"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "kind",
    "schemaVersion",
    "id",
    "version",
    "proposalSha256",
    "validator",
    "valid",
    "findings"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tyr:contract:1.1.0:validation-report"
}
