{
  "type": "object",
  "properties": {
    "kind": {
      "const": "review-record"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "version": {
      "$ref": "common.schema.json#/$defs/version"
    },
    "target": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "source-definition",
            "mapping-set",
            "semantic-definition"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._/-]*$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "kind",
        "id",
        "version",
        "sha256"
      ],
      "additionalProperties": false
    },
    "decision": {
      "enum": [
        "reviewed",
        "needs-review",
        "disputed"
      ]
    },
    "by": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._/-]*$"
    },
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/evidenceRef"
      },
      "minItems": 1
    },
    "deviceVerification": {
      "const": "not-performed"
    }
  },
  "required": [
    "kind",
    "schemaVersion",
    "id",
    "version",
    "target",
    "decision",
    "by",
    "at",
    "rationale",
    "evidenceRefs",
    "deviceVerification"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tyr:contract:1.0.0:review-record"
}
