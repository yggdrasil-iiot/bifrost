{
  "type": "object",
  "properties": {
    "kind": {
      "const": "attribution-rule"
    },
    "schemaVersion": {
      "const": "2.27.0"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "version": {
      "$ref": "common.schema.json#/$defs/version"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "equipmentRef": {
      "$ref": "common.schema.json#/$defs/documentRef"
    },
    "stations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/equipmentPath"
      },
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true
    },
    "members": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "object",
        "properties": {
          "mappingSetRef": {
            "$ref": "common.schema.json#/$defs/documentRef"
          },
          "mappingId": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "semanticId": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048
          },
          "metric": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "required": [
          "mappingSetRef",
          "mappingId",
          "semanticId",
          "metric"
        ],
        "additionalProperties": false
      }
    },
    "activity": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "properties": {
          "equipmentPath": {
            "$ref": "#/$defs/equipmentPath"
          },
          "memberRef": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "activeWhen": {
            "const": true
          }
        },
        "required": [
          "equipmentPath",
          "memberRef",
          "activeWhen"
        ],
        "additionalProperties": false
      }
    },
    "occupancyBindingRef": {
      "$ref": "common.schema.json#/$defs/documentRef"
    },
    "identity": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "occupancy-join"
            },
            "namespace": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "crossCheck": {
              "enum": [
                "none",
                "occupancy"
              ]
            }
          },
          "required": [
            "mode",
            "crossCheck"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "plc-stamped"
            },
            "namespace": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "members": {
              "type": "array",
              "minItems": 1,
              "maxItems": 256,
              "items": {
                "type": "object",
                "properties": {
                  "equipmentPath": {
                    "$ref": "#/$defs/equipmentPath"
                  },
                  "unitMemberRef": {
                    "$ref": "common.schema.json#/$defs/id"
                  },
                  "visitMemberRef": {
                    "$ref": "common.schema.json#/$defs/id"
                  },
                  "presentMemberRef": {
                    "$ref": "common.schema.json#/$defs/id"
                  }
                },
                "required": [
                  "equipmentPath",
                  "unitMemberRef",
                  "visitMemberRef",
                  "presentMemberRef"
                ],
                "additionalProperties": false
              }
            },
            "crossCheck": {
              "enum": [
                "none",
                "occupancy"
              ]
            }
          },
          "required": [
            "mode",
            "namespace",
            "members",
            "crossCheck"
          ],
          "additionalProperties": false
        }
      ]
    },
    "temporal": {
      "type": "object",
      "properties": {
        "timestampBasis": {
          "const": "source"
        },
        "outOfOrdernessMs": {
          "$ref": "#/$defs/ms"
        },
        "allowedLatenessMs": {
          "$ref": "#/$defs/ms"
        },
        "horizonMs": {
          "$ref": "#/$defs/ms"
        },
        "enterToleranceMs": {
          "$ref": "#/$defs/ms"
        },
        "leaveToleranceMs": {
          "$ref": "#/$defs/ms"
        }
      },
      "required": [
        "timestampBasis",
        "outOfOrdernessMs",
        "allowedLatenessMs",
        "horizonMs",
        "enterToleranceMs",
        "leaveToleranceMs"
      ],
      "additionalProperties": false
    },
    "quality": {
      "type": "object",
      "properties": {
        "uncertainInput": {
          "enum": [
            "propagate",
            "reject"
          ]
        },
        "maxBadShare": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "uncertainInput",
        "maxBadShare"
      ],
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "properties": {
        "expectedPeriodMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000
        },
        "maxMissingPeriods": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "expectedPeriodMs",
        "maxMissingPeriods"
      ],
      "additionalProperties": false
    },
    "overlap": {
      "type": "object",
      "properties": {
        "policy": {
          "const": "reject-ambiguous"
        }
      },
      "required": [
        "policy"
      ],
      "additionalProperties": false
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/evidenceRef"
      },
      "maxItems": 64
    }
  },
  "required": [
    "kind",
    "schemaVersion",
    "id",
    "version",
    "label",
    "description",
    "equipmentRef",
    "stations",
    "members",
    "activity",
    "occupancyBindingRef",
    "identity",
    "temporal",
    "quality",
    "coverage",
    "overlap",
    "evidenceRefs"
  ],
  "additionalProperties": false,
  "$defs": {
    "equipmentPath": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._/-]*(:[a-z][a-z0-9._/-]*)*$",
      "maxLength": 4096
    },
    "ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 86400000
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tyr:contract:2.27.0:attribution-rule"
}
