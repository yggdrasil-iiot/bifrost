<?xml version="1.0" encoding="UTF-8"?>
<!-- Keep root at INFO to suppress the TRACE-level log spam from Tahu internals. logback 1.3.x compatible syntax. -->
<configuration>
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} %-5level %logger{24} - %msg%n</pattern>
    </encoder>
  </appender>
  <root level="INFO">
    <appender-ref ref="STDOUT"/>
  </root>
</configuration>
