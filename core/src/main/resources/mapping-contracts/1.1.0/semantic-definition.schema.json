{
  "type": "object",
  "properties": {
    "kind": {
      "const": "semantic-definition"
    },
    "schemaVersion": {
      "const": "1.1.0"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "version": {
      "$ref": "common.schema.json#/$defs/version"
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "memberId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._/-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "semanticId": {
            "type": "string",
            "format": "uri"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "valueType": {
            "$ref": "common.schema.json#/$defs/resultType"
          },
          "unit": {
            "$ref": "common.schema.json#/$defs/unit"
          },
          "role": {
            "enum": [
              "measurement",
              "status",
              "setpoint"
            ]
          },
          "range": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "low": {
                    "type": "string",
                    "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
                  },
                  "high": {
                    "type": "string",
                    "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
                  }
                },
                "required": [
                  "low",
                  "high"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "memberId",
          "name",
          "semanticId",
          "description",
          "valueType",
          "unit",
          "role",
          "range"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "kind",
    "schemaVersion",
    "id",
    "version",
    "members"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tyr:contract:1.1.0:semantic-definition"
}
