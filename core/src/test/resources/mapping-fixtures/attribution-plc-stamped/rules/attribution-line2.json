{
  "kind": "attribution-rule",
  "schemaVersion": "2.27.0",
  "id": "line2-attribution",
  "version": "1.0.0",
  "label": "Line 2 plc-stamped attribution",
  "description": "Attributes nutrunner torque samples to the visit the station controller stamps in the same message.",
  "equipmentRef": {
    "id": "line2-plant",
    "version": "1.0.0"
  },
  "stations": [
    "synthetic-site:line2:station1",
    "synthetic-site:line2:station2",
    "synthetic-site:line2:station3"
  ],
  "members": [
    {
      "mappingSetRef": {
        "id": "nutrunner1-mapping",
        "version": "1.0.0"
      },
      "mappingId": "nutrunner1-torque",
      "semanticId": "urn:bifrost:sem:Tool/Torque",
      "metric": "Torque"
    },
    {
      "mappingSetRef": {
        "id": "station1-mapping",
        "version": "1.0.0"
      },
      "mappingId": "station1-running",
      "semanticId": "urn:bifrost:sem:Station/Running",
      "metric": "Running"
    },
    {
      "mappingSetRef": {
        "id": "nutrunner1-mapping",
        "version": "1.0.0"
      },
      "mappingId": "nutrunner1-running",
      "semanticId": "urn:bifrost:sem:Tool/Running",
      "metric": "Running"
    },
    {
      "mappingSetRef": {
        "id": "station1-mapping",
        "version": "1.0.0"
      },
      "mappingId": "station1-unit",
      "semanticId": "urn:bifrost:sem:Station/UnitId",
      "metric": "UnitId"
    },
    {
      "mappingSetRef": {
        "id": "station1-mapping",
        "version": "1.0.0"
      },
      "mappingId": "station1-visit",
      "semanticId": "urn:bifrost:sem:Station/VisitId",
      "metric": "VisitId"
    },
    {
      "mappingSetRef": {
        "id": "station1-mapping",
        "version": "1.0.0"
      },
      "mappingId": "station1-present",
      "semanticId": "urn:bifrost:sem:Station/VisitPresent",
      "metric": "VisitPresent"
    },
    {
      "mappingSetRef": {
        "id": "nutrunner1-mapping",
        "version": "1.0.0"
      },
      "mappingId": "nutrunner1-unit",
      "semanticId": "urn:bifrost:sem:Tool/UnitId",
      "metric": "UnitId"
    },
    {
      "mappingSetRef": {
        "id": "nutrunner1-mapping",
        "version": "1.0.0"
      },
      "mappingId": "nutrunner1-visit",
      "semanticId": "urn:bifrost:sem:Tool/VisitId",
      "metric": "VisitId"
    },
    {
      "mappingSetRef": {
        "id": "nutrunner1-mapping",
        "version": "1.0.0"
      },
      "mappingId": "nutrunner1-present",
      "semanticId": "urn:bifrost:sem:Tool/VisitPresent",
      "metric": "VisitPresent"
    }
  ],
  "activity": [
    {
      "equipmentPath": "synthetic-site:line2:station1",
      "memberRef": "station1-running",
      "activeWhen": true
    },
    {
      "equipmentPath": "synthetic-site:line2:station1:nutrunner1",
      "memberRef": "nutrunner1-running",
      "activeWhen": true
    }
  ],
  "occupancyBindingRef": {
    "id": "occupancy-binding-line2",
    "version": "1.0.0"
  },
  "identity": {
    "mode": "plc-stamped",
    "namespace": "urn:line2:visits",
    "members": [
      {
        "equipmentPath": "synthetic-site:line2:station1",
        "unitMemberRef": "station1-unit",
        "visitMemberRef": "station1-visit",
        "presentMemberRef": "station1-present"
      },
      {
        "equipmentPath": "synthetic-site:line2:station1:nutrunner1",
        "unitMemberRef": "nutrunner1-unit",
        "visitMemberRef": "nutrunner1-visit",
        "presentMemberRef": "nutrunner1-present"
      }
    ],
    "crossCheck": "occupancy"
  },
  "temporal": {
    "timestampBasis": "source",
    "outOfOrdernessMs": 30000,
    "allowedLatenessMs": 720000,
    "horizonMs": 86400000,
    "enterToleranceMs": 45000,
    "leaveToleranceMs": 45000
  },
  "quality": {
    "uncertainInput": "reject",
    "maxBadShare": 0.1
  },
  "coverage": {
    "expectedPeriodMs": 1000,
    "maxMissingPeriods": 3
  },
  "overlap": {
    "policy": "reject-ambiguous"
  },
  "evidenceRefs": [
    {
      "artifactId": "manual-line2",
      "locator": {
        "kind": "text-line",
        "line": 7
      }
    }
  ]
}
